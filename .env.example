# Copy to .env and replace with your receiver's IP address.
PIONEER_IP=192.0.2.100
PIONEER_PORT=8102

# Published HTTP port (the container listens on 8099).
PORT=8099

# Optional existing deployment network. Leave empty for a managed default network.
DEPLOYMENT_NET=
# Set true when DEPLOYMENT_NET names an existing external network.
DEPLOYMENT_NET_EXTERNAL=false
